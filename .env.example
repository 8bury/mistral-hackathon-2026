# Copy to .env and fill in. Never commit the real .env.
MISTRAL_API_KEY=

# Optional model overrides (defaults shown)
# MISTRAL_MODEL_ROUTER=ministral-8b-latest
# MISTRAL_MODEL_GROUNDING=pixtral-12b-latest
# MISTRAL_MODEL_GUIDE=mistral-large-latest

# Server
PORT=3001

# Voxtral voice (defaults shown; override to use different preset voices or a
# cloned voice ID from AI Studio, e.g. VOICE_ID_CHILD for the teammate clone)
# VOXTRAL_STT_MODEL=voxtral-mini-transcribe-3
# VOXTRAL_TTS_MODEL=voxtral-mini-tts-3-0
# VOICE_ID_CHILD=voice_1786
# VOICE_ID_ARCHITECT=voice_1788
# VOICE_ID_HISTORIAN=voice_3147
# VOICE_ID_ES=voice_483

# Web (used by Vite at build/dev time)
VITE_API_URL=http://localhost:3001
# Mocks are OFF by default; set to "true" to use the built-in mock instead of
# the real server. VITE_MOCK_ASK=true mocks only /api/ask.
# VITE_MOCK_API=true
